# Data (never committed). The one exception is the small demo model (weights only,
# no EEG), so that `neurolink demo` works without training.
data/*
!data/.gitkeep
!data/models/
data/models/*
!data/models/demo_model.pt

# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Results: keep JSON/markdown/PNG summaries, drop checkpoints and logs
results/**/*.pt
results/**/*.pth
results/**/*.log
results/cache/

# Frontend
frontend/node_modules/
frontend/dist/

# OS / editors
.DS_Store
Thumbs.db
.vscode/
.idea/
